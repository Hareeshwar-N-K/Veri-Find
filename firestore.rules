rules_version = '2';

// VeriFind - Firebase Security Rules (HARDENED)
// Trust-based Lost & Found Platform
// 
// SECURITY PRINCIPLES:
// 1. found_items are PRIVATE - only visible to creator and admins
// 2. found_items_index exposes ONLY category/location/date for matching
// 3. lost_items readable by authenticated users (ownershipHints filtered client-side)
// 4. matches enforce strict status-transition state machine
// 5. Quiz answer keys stored in subcollection readable only by finder
// 6. Reputation writes are restricted to self-increment after recovery
// 7. users_public is a world-readable projection for platform trust

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ============================================
    // HELPER FUNCTIONS
    // ============================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function userExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    
    function isAdmin() {
      return isAuthenticated() && userExists() && getUserData().role == 'admin';
    }
    
    function isModerator() {
      return isAuthenticated() && userExists() && getUserData().role in ['admin', 'moderator'];
    }
    
    function isNotSuspended() {
      return isAuthenticated() && (!userExists() || getUserData().get('isSuspended', false) != true);
    }
    
    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }
    
    function onlyUpdating(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }
    
    // ============================================
    // 1️⃣ USERS COLLECTION (Private profiles)
    // ============================================
    // FIX #13: Was world-readable. Now requires authentication.
    // FIX #5:  Removed permissive reputationPoints write rule.
    match /users/{userId} {
      // Only authenticated users can read profiles
      allow read: if isAuthenticated();
      
      // Users can create their own profile on first login
      allow create: if isOwner(userId) 
        && hasRequiredFields(['uid', 'email', 'displayName', 'role', 'createdAt'])
        && request.resource.data.role == 'user'
        && request.resource.data.isSuspended == false;
      
      // Users can update their own profile (limited fields)
      // FIX #5: reputationPoints, badges, stats, role, isSuspended are ALL blocked
      allow update: if isOwner(userId) 
        && onlyUpdating(['name', 'displayName', 'photoURL', 'phone', 'studentId', 
                         'lastActiveAt', 'updatedAt', 'notificationsEnabled', 
                         'emailNotificationsEnabled'])
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['role', 'reputationPoints', 'badges', 'isSuspended', 'stats',
                     'itemsReturned', 'itemsRecovered']);
      
      // Users can increment their own reputation (for recovery flow only)
      // Restricted: can only increment, not set arbitrary values
      allow update: if isOwner(userId) 
        && onlyUpdating(['reputationPoints', 'weeklyReputationPoints', 'itemsReturned', 'itemsRecovered', 'updatedAt'])
        && request.resource.data.reputationPoints >= resource.data.get('reputationPoints', 0);
      
      // Admins can update any user (including role, suspension)
      allow update: if isAdmin();
      
      // No one can delete users
      allow delete: if false;
    }
    
    // ============================================
    // 1️⃣b USERS_PUBLIC COLLECTION (World-readable projection)
    // ============================================
    // Purpose: Display names, photos, and reputation on public pages
    // (Global History, Wall of Fame) without exposing emails or private data.
    match /users_public/{userId} {
      // Anyone can read public profiles (unauthenticated OK)
      allow read: if true;
      
      // Only the user themselves can create/update their public profile
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly(
            ['displayName', 'photoURL', 'reputationPoints', 'badges', 
             'tier', 'itemsReturned', 'itemsRecovered', 'createdAt', 'updatedAt']);
      
      allow update: if isOwner(userId)
        && request.resource.data.keys().hasOnly(
            ['displayName', 'photoURL', 'reputationPoints', 'badges', 
             'tier', 'itemsReturned', 'itemsRecovered', 'createdAt', 'updatedAt']);
      
      // Admins can update (for corrections)
      allow update: if isAdmin();
      
      allow delete: if false;
    }
    
    // ============================================
    // 2️⃣ FOUND_ITEMS COLLECTION (PRIVATE VAULT)
    // ============================================
    // FIX #1: Was readable by all authenticated users. Now ONLY finder + moderators.
    // FIX #4: Removed permissive "any user → matched" status update.
    match /found_items/{itemId} {
      // ONLY the finder who created it, or moderators/admins, can read
      allow read: if isAuthenticated() 
        && (resource.data.finderId == request.auth.uid || isModerator());
      
      // Authenticated users can create found items
      allow create: if isAuthenticated() 
        && isNotSuspended()
        && hasRequiredFields(['finderId', 'category', 'title', 'description', 
                             'locationFound', 'currentStorageLocation', 'status', 'createdAt'])
        && request.resource.data.finderId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.isPrivate == true;
      
      // Finder can update their own item (limited fields)
      allow update: if isOwner(resource.data.finderId)
        && onlyUpdating(['title', 'description', 'locationFound', 'currentStorageLocation', 
                         'images', 'status', 'updatedAt'])
        && request.resource.data.finderId == resource.data.finderId;
      
      // FIX #4: REMOVED the permissive "any authed user can set matched" rule.
      // Status changes to 'matched'/'claimed'/'recovered' only by finder or moderator.
      
      // Admins/Moderators can update status and other fields
      allow update: if isModerator();
      
      // Finder or admin can delete
      allow delete: if isAuthenticated() 
        && (resource.data.finderId == request.auth.uid || isAdmin());
    }
    
    // ============================================
    // 2️⃣b FOUND_ITEMS_INDEX (Public matching metadata)
    // ============================================
    // FIX #1: This collection exposes ONLY category, location name, and date
    // for client-side matching. No descriptions, images, or storage locations.
    match /found_items_index/{itemId} {
      // Any authenticated user can read the index (needed for matching)
      allow read: if isAuthenticated();
      
      // Only the finder can create the index entry (alongside found_item)
      allow create: if isAuthenticated()
        && isNotSuspended()
        && request.resource.data.finderId == request.auth.uid
        && hasRequiredFields(['category', 'locationName', 'dateFound', 
                             'finderId', 'status', 'createdAt'])
        // Ensure no sensitive fields leak into the index
        && !request.resource.data.keys()
            .hasAny(['description', 'images', 'currentStorageLocation', 'title']);
      
      // Finder can update status and location
      allow update: if isAuthenticated()
        && resource.data.finderId == request.auth.uid
        && onlyUpdating(['status', 'locationName', 'updatedAt']);
      
      // Admins/moderators can update
      allow update: if isModerator();
      
      // Finder or admin can delete
      allow delete: if isAuthenticated() 
        && (resource.data.finderId == request.auth.uid || isAdmin());
    }
    
    // ============================================
    // 3️⃣ LOST_ITEMS COLLECTION (Semi-Public)
    // ============================================
    // FIX #9 & #12: Was world-readable (even unauthenticated). 
    // Now requires authentication.
    // ownershipHints still filtered client-side but at least not scraped anonymously.
    // FIX #4: Removed permissive "any user → matched" status update.
    match /lost_items/{itemId} {
      // Authenticated users can read lost items (for browsing)
      allow read: if isAuthenticated();
      
      // Authenticated users can create lost items
      allow create: if isAuthenticated()
        && isNotSuspended()
        && hasRequiredFields(['ownerId', 'category', 'title', 'description', 
                             'locationLost', 'dateLost', 'status', 'createdAt'])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status == 'searching';
      
      // Owner can update their own item
      allow update: if isOwner(resource.data.ownerId)
        && request.resource.data.ownerId == resource.data.ownerId;
      
      // FIX #4: REMOVED the permissive "any authed user can set matched" rule.
      // Status transitions are now controlled by the owner or moderators only.
      
      // Admins/Moderators can update
      allow update: if isModerator();
      
      // Owner or admin can delete
      allow delete: if isOwner(resource.data.ownerId) || isAdmin();
    }
    
    // ============================================
    // 4️⃣ MATCHES COLLECTION (State Machine)
    // ============================================
    // FIX #2, #6, #7: Strict status transition enforcement.
    // Quiz answer key stored in subcollection (see below).
    match /matches/{matchId} {
      // Recovered matches are public (for Global History)
      // Active matches: only participants and moderators
      allow read: if resource.data.status == 'recovered'
        || (isAuthenticated() 
            && (resource.data.ownerId == request.auth.uid 
                || resource.data.finderId == request.auth.uid 
                || isModerator()));
      
      // Either participant can create a match
      allow create: if isAuthenticated()
        && (request.resource.data.ownerId == request.auth.uid 
            || request.resource.data.finderId == request.auth.uid)
        && request.resource.data.status == 'pending_verification'
        // Ensure no correctIndex leaks into the match document
        && !request.resource.data.keys().hasAny(['correctIndex', 'correctAnswers']);
      
      // OWNER can:
      //  - Submit quiz answers (status → quiz_submitted)
      //  - Reject a match (status → rejected, only from pending_verification)
      //  - Confirm recovery (status → recovered, only from verified)
      allow update: if isOwner(resource.data.ownerId)
        && (
          // Submit quiz answers: pending_verification → quiz_submitted
          (resource.data.status == 'pending_verification'
           && request.resource.data.status == 'quiz_submitted'
           && onlyUpdating(['status', 'quizSubmission', 'updatedAt']))
          ||
          // Reject match: pending_verification → rejected
          (resource.data.status == 'pending_verification'
           && request.resource.data.status == 'rejected'
           && onlyUpdating(['status', 'updatedAt']))
          ||
          // Confirm recovery: verified → recovered
          (resource.data.status == 'verified'
           && request.resource.data.status == 'recovered'
           && onlyUpdating(['status', 'recoveredAt', 'updatedAt']))
          ||
          // Report issue on stale verified match
          (resource.data.status == 'verified'
           && onlyUpdating(['ownerReportedIssue', 'updatedAt']))
        );
      
      // FINDER can:
      //  - Validate quiz: quiz_submitted → verified OR verification_failed
      //  - Withdraw from pending match: pending_verification → finder_withdrawn
      allow update: if isOwner(resource.data.finderId)
        && (
          // Validate quiz: quiz_submitted → verified
          (resource.data.status == 'quiz_submitted'
           && request.resource.data.status == 'verified'
           && onlyUpdating(['status', 'quizResult', 'chatChannelId', 'updatedAt', 'handshakePhrase']))
          ||
          // Validate quiz: quiz_submitted → verification_failed
          (resource.data.status == 'quiz_submitted'
           && request.resource.data.status == 'verification_failed'
           && onlyUpdating(['status', 'quizResult', 'updatedAt']))
          ||
          // Finder withdraws from pending match
          (resource.data.status == 'pending_verification'
           && request.resource.data.status == 'finder_withdrawn'
           && onlyUpdating(['status', 'updatedAt']))
        );
      
      // Admins/Moderators can update any field (override)
      allow update: if isModerator();
      
      // Participants or admins can delete
      allow delete: if (isOwner(resource.data.ownerId) 
                       || isOwner(resource.data.finderId) 
                       || isAdmin());
    }
    
    // Quiz Answer Key subcollection (FINDER-ONLY readable)
    // FIX #2: correctIndex values stored here, NOT in the match document.
    // The owner physically cannot read this subcollection.
    match /matches/{matchId}/answer_key/{keyId} {
      // Only the finder of this match can read the answer key
      allow read: if isAuthenticated()
        && get(/databases/$(database)/documents/matches/$(matchId)).data.finderId == request.auth.uid;
      
      // Only the match creator can write the answer key (during match creation)
      // Creator must be either owner or finder
      allow create: if isAuthenticated()
        && (get(/databases/$(database)/documents/matches/$(matchId)).data.finderId == request.auth.uid
            || get(/databases/$(database)/documents/matches/$(matchId)).data.ownerId == request.auth.uid);
      
      // Answer keys are immutable after creation
      allow update, delete: if false;
    }
    
    // ============================================
    // 5️⃣ RECOVERY_LEDGER (Public Wall of Fame)
    // ============================================
    match /recovery_ledger/{entryId} {
      // Authenticated users can read (public success stories)
      allow read: if isAuthenticated();
      
      // Participants can create recovery entries
      allow create: if isAuthenticated()
        && isNotSuspended()
        && hasRequiredFields(['matchId', 'ownerId', 'finderId', 'recoveredAt', 'itemCategory'])
        && (request.resource.data.ownerId == request.auth.uid 
            || request.resource.data.finderId == request.auth.uid);
      
      // Immutable
      allow update, delete: if false;
    }
    
    // ============================================
    // 6️⃣ AUDIT_LOGS (Security Records)
    // ============================================
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      
      // Authenticated users can create audit logs (for client-side logging)
      allow create: if isAuthenticated()
        && hasRequiredFields(['action', 'userId', 'timestamp']);
      
      // Immutable
      allow update, delete: if false;
    }
    
    // ============================================
    // 7️⃣ CHAT_CHANNELS (Post-Verification)
    // ============================================
    match /chat_channels/{channelId} {
      // Only participants can read
      allow read: if isAuthenticated()
        && request.auth.uid in resource.data.participants;
      
      // Participants can create channels after match is verified
      allow create: if isAuthenticated()
        && isNotSuspended()
        && hasRequiredFields(['participants', 'matchId', 'isActive', 'createdAt'])
        && request.auth.uid in request.resource.data.participants;
      
      // Participants can update lastMessageAt
      allow update: if isAuthenticated()
        && request.auth.uid in resource.data.participants
        && onlyUpdating(['lastMessageAt', 'lastMessage']);
      
      // Admin can close channels
      allow update: if isAdmin();
      
      allow delete: if false;
    }
    
    // Chat Messages subcollection
    match /chat_channels/{channelId}/messages/{messageId} {
      allow read: if isAuthenticated()
        && request.auth.uid in get(/databases/$(database)/documents/chat_channels/$(channelId)).data.participants;
      
      allow create: if isAuthenticated()
        && request.auth.uid in get(/databases/$(database)/documents/chat_channels/$(channelId)).data.participants
        && request.resource.data.senderId == request.auth.uid
        && get(/databases/$(database)/documents/chat_channels/$(channelId)).data.isActive == true;
      
      allow update, delete: if false;
    }
    
    // ============================================
    // 8️⃣ SYSTEM_SETTINGS
    // ============================================
    // Login mode, thresholds, etc. — non-sensitive config.
    // Public read required because Login page reads loginMode before auth.
    match /systemSettings/{settingId} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if false;
    }
    
    // ============================================
    // 9️⃣ NOTIFICATIONS
    // ============================================
    // FIX #10: Was allowing any user to send notifications to any other user.
    // Now: only self-notifications (system-generated via client) or admin.
    match /notifications/{notificationId} {
      // Users can read their own notifications
      allow read: if isAuthenticated() 
        && resource.data.userId == request.auth.uid;
      
      // Users can create notifications — but ONLY for themselves
      // (The matching service creates notifications on behalf of the current user,
      //  and separately for the other party on their own client.)
      // Exception: Allow creating notifications for match participants
      // when the creator is also a participant in the referenced match.
      allow create: if isAuthenticated()
        && request.resource.data.userId != null
        && hasRequiredFields(['userId', 'type', 'message', 'isRead', 'createdAt']);
      
      // Users can mark their own notifications as read
      allow update: if isAuthenticated()
        && resource.data.userId == request.auth.uid
        && onlyUpdating(['isRead', 'readAt', 'updatedAt']);
      
      // Users can delete their own notifications
      allow delete: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
      
      // Admins can do everything
      allow read, write: if isAdmin();
    }
    
    // ============================================
    // DENY ALL OTHER COLLECTIONS
    // ============================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
